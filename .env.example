# ME Producciones — required environment variables.
# Copy to `.env.local` for development, and set the same keys in the Vercel project settings for
# Preview and Production. Missing variables no longer pass silently: the app fails safe (admin login
# is refused; public pages degrade to an empty state behind an error boundary rather than a blank 500).

# ── Supabase (public — inlined into the client bundle at BUILD time) ───────────
# NOTE: because NEXT_PUBLIC_* is baked at build time, changing these in Vercel requires a REDEPLOY.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ── Supabase (server-only — NEVER expose to the browser) ──────────────────────
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Admin portal credentials (server-only) ────────────────────────────────────
# Use a strong, unique username and password. The admin session signing key is derived from these,
# so rotating the password invalidates all existing admin sessions.
ADMIN_USERNAME=<choose-a-strong-admin-username>
ADMIN_PASSWORD=<choose-a-strong-random-password>

# ── Optional ──────────────────────────────────────────────────────────────────
# Canonical site URL for metadata / sitemap / robots (defaults to https://www.meproducciones.com).
NEXT_PUBLIC_SITE_URL=https://www.meproducciones.com
# Supabase Storage bucket for media (defaults to "meproducciones-media").
NEXT_PUBLIC_STORAGE_BUCKET=meproducciones-media
